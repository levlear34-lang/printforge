# Copy to .env for local development. Never commit the real .env file.

ENVIRONMENT=development

# Postgres connection string (Supabase or Neon). Needed for accounts/dashboard
# (Milestone 5) -- everything else works without it. For Supabase, use the
# "Transaction" mode pooler connection string (port 6543) from
# Project Settings -> Database -> Connection string, not the Data API
# URL/anon key/service_role key (this backend connects directly via
# psycopg, not Supabase's REST API).
DATABASE_URL=

# Random long secret for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Fernet key (NOT just any random string) used to encrypt saved Kaggle
# tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
