# Copy to .env for local development. Never commit the real .env file.

ENVIRONMENT=development

# Postgres connection string (Supabase or Neon). Not needed until milestone 5.
DATABASE_URL=

# Random long secret for session/auth signing. Not needed until milestone 5.
SESSION_SECRET=

# Random 32-byte key (base64) used to encrypt saved Kaggle tokens at rest.
# Not needed until milestone 5. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=
